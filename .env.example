# ========== 公网域名 ==========
# 同机 xtai-notion：由 notion 的 nginx 反代 → docker-compose.yml
# 仅部署本仓库：自带 nginx → docker-compose.standalone.yml（见 DEPLOY-STANDALONE.md）
DOMAIN=xtai-nav.cn
NEXT_PUBLIC_BASE_URL=https://xtai-nav.cn
BETTER_AUTH_URL=https://xtai-nav.cn
BETTER_AUTH_SECRET=请替换为 better-auth 生成的密钥

# ========== 单项目部署可选（docker-compose.standalone.yml）==========
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# SSL_DIR=./ssl
# PORT=3000

# ========== 数据库 ==========
DATABASE_URL=postgresql://user:pass@host:6543/postgres?pgbouncer=true

# ========== AI ==========
DEEPSEEK_API_KEY=

# ========== Docker 构建（国内可选）==========
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine

# process.env  

NEXT_PUBLIC_BASE_URL=http://$NAME:$PORT

OPENAI_API_KEY=xxxxxxxxx
DEEPSEEK_API_KEY=xxxxxxxxx

# 可选：搜索 Agent 外网检索（Azure Bing Web Search v7）
# https://learn.microsoft.com/en-us/bing/search-apis/bing-web-search/overview
BING_SEARCH_API_KEY=
# BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
# BING_SEARCH_MKT=zh-CN

# 可选：网站搜集 Agent — Model Context Protocol
# 当数据库中存在「已启用」的 MCP 配置时，优先生效；否则才使用下列环境变量：
# （管理后台 → MCP 配置：支持 stdio / http / sse 及 JSON 导入）
# WEBSITE_COLLECTOR_MCP_TRANSPORT=off
# http / sse / stdio
# WEBSITE_COLLECTOR_MCP_URL=http://localhost:3000/mcp
# WEBSITE_COLLECTOR_MCP_COMMAND=node
# WEBSITE_COLLECTOR_MCP_ARGS=["./mcp-server.js"]
# WEBSITE_COLLECTOR_MCP_HEADERS={"Authorization":"Bearer xxx"}
# 启用后与 MCP 的人机追问协议握手（管理端当前会 decline，见 https://ai-sdk.dev/cookbook/node/mcp-elicitation）
# WEBSITE_COLLECTOR_MCP_ELICITATION=false


